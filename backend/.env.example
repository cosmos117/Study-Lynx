PORT=5000
DATABASE_URL="mysql://username:password@localhost:3306/ai_study_planner"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
# Google sign-in (OAuth 2.0 Web client ID from Google Cloud Console; leave blank to disable)
GOOGLE_CLIENT_ID=
CORS_ORIGIN="http://localhost:5173"
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq
# Gemini model id, e.g. gemini-3.5-flash. Google retires old models, so update this if AI calls start failing with 404.
# Gemini model id. On the free tier, Flash-Lite models allow 15 requests/min and 500/day;
# full Flash models only 5/min and 20/day. Check yours in Google AI Studio -> Rate Limit.
AI_MODEL=gemini-3.5-flash-lite
AI_FALLBACK_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
AI_TEMPERATURE=0.3
AI_TIMEOUT_MS=30000
# Gemini's hidden reasoning before answering. "low" is ~2-3x faster (a quiz in ~6 s instead of ~15 s);
# "default" lets the model decide.
AI_THINKING_LEVEL=low
AI_MAX_RETRIES=3
# Shared by all users per day (counted on Google's Pacific-time day). Keep it ~10% under your
# model's requests per day, so students get a clear "try again later" instead of errors. Empty = no cap.
AI_DAILY_LIMIT=450
# Per student per day, so one person can't use up everyone's shared quota.
AI_USER_DAILY_LIMIT=15
# Shared by all users per minute; keep just under your model's requests per minute.
AI_REQUESTS_PER_MINUTE=14
AI_LOCK_TIMEOUT_SECONDS=90
AI_INPUT_MAX_CHARS=12000

# RAG / Materials / AI Tutor
RAG_TOP_K=5
# Leave empty to use the embedding provider's own default (0.6 for Gemini, 0.35 offline).
RAG_SIMILARITY_THRESHOLD=
RAG_MAX_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=200
RAG_MAX_DOCUMENT_CHARS=300000
RAG_MAX_FILE_SIZE_MB=10
RAG_ALLOWED_MIME_TYPES=application/pdf,text/plain
# auto = Gemini embeddings when GEMINI_API_KEY is set (much better search), else an offline keyword fallback.
# Changing provider is safe: older passages are re-indexed automatically the next time they're searched.
RAG_EMBEDDING_PROVIDER=auto
RAG_EMBEDDING_MODEL=gemini-embedding-001
# Embedding quota (free tier: 100 requests and 30K tokens per minute); uploads are paced under these.
RAG_EMBED_REQUESTS_PER_MINUTE=90
RAG_EMBED_TOKENS_PER_MINUTE=28000
